{
  "name": "allright-qa-automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "setup:linux": "playwright install --with-deps chromium",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "generate:test": "node bonus/generate-test.mjs",
    "test:generated": "playwright test --config bonus/playwright.config.ts bonus/examples"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
